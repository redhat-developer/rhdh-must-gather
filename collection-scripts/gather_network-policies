#!/usr/bin/env bash

# NetworkPolicy diagnostic collection
# Collects live NetworkPolicy resources from RHDH-related namespaces.

set -euo pipefail

DIR_NAME=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )
source "${DIR_NAME}/common.sh"

log_info "Starting NetworkPolicy collection..."

np_dir="$BASE_COLLECTION_PATH/network-policies"
ensure_directory "$np_dir"

if [[ -z "${KUBECTL_CMD:-}" ]]; then
    log_warn "No kubectl or oc command available. Skipping NetworkPolicy collection."
    echo "kubectl/oc not available - NetworkPolicy collection skipped" > "$np_dir/skipped.txt"
    exit 0
fi

declare -a namespaces_to_collect=()

if [[ -n "${RHDH_TARGET_NAMESPACES:-}" ]]; then
    log_info "Collecting NetworkPolicies from targeted namespaces: $RHDH_TARGET_NAMESPACES"
    IFS=',' read -ra namespaces_to_collect <<< "$RHDH_TARGET_NAMESPACES"
else
    log_info "Auto-detecting namespaces with RHDH deployments..."

    helm_namespaces=$(helm list --all-namespaces -o json 2>/dev/null \
        | jq -r '.[] | select(.chart | test("backstage|rhdh|developer-hub"; "i")) | .namespace' \
        | sort | uniq || echo "")
    
    RHDH_PATTERN="backstage|rhdh|developer-hub"
    RHDH_IMAGE_PATTERN="quay.io/rhdh|registry.redhat.io/rhdh|ghcr.io/backstage/backstage"
    standalone_namespaces=$($KUBECTL_CMD get deployments --all-namespaces -l "app.kubernetes.io/managed-by=Helm" -o json 2>/dev/null | jq -r --arg pattern "$RHDH_PATTERN" --arg img_pattern "$RHDH_IMAGE_PATTERN" '
      .items[] |
      select(
        (.metadata.labels["helm.sh/chart"] // "" | test($pattern; "i")) or 
        (.metadata.labels["app.kubernetes.io/name"] // "" | test($pattern; "i")) or
        (.metadata.labels["app.kubernetes.io/instance"] // "" | test($pattern; "i")) or 
        (.spec.template.spec.containers[]?.image // "" | test($img_pattern; "i")) or
        (.spec.template.spec.initContainers[]?.image // "" | test($img_pattern; "i"))
      ) |
      .metadata.namespace 
    ' 2>/dev/null | sort | uniq || echo "")

    cr_namespaces=$($KUBECTL_CMD get backstages.rhdh.redhat.com --all-namespaces -o jsonpath='{.items[*].metadata.namespace}' 2>/dev/null \
      | tr ' ' '\n' | sort | uniq || echo "")
    operator_namespaces=$($KUBECTL_CMD get deployments --all-namespaces -l app=rhdh-operator -o jsonpath='{.items[*].metadata.namespace}' 2>/dev/null \
        | tr ' ' '\n' | sort | uniq || echo "")
    all_namespaces=$(echo -e "${helm_namespaces}\n${standalone_namespaces}\n${cr_namespaces}\n${operator_namespaces}" | grep -v '^$' | sort | uniq || echo "")
    while IFS= read -r ns; do
        [[ -n "$ns" ]] && namespaces_to_collect+=("$ns")
    done <<< "$all_namespaces"
    if [[ -n "$operator_namespaces" ]]; then
        log_info "Auto-detected RHDH operator namespace(s): $operator_namespaces"
    fi
fi

if [[ -z "${RHDH_TARGET_NAMESPACES:-}" ]]; then
    orch_ns_file="$BASE_COLLECTION_PATH/orchestrator/detected-namespaces.txt"
    if [[ -s "$orch_ns_file" ]]; then
        log_info "Adding orchestrator-related namespaces to NetworkPolicy collection..."
        while IFS= read -r orch_ns; do
            orch_ns=$(echo "$orch_ns" | xargs)
            [[ -z "$orch_ns" ]] && continue
            already_included=false
            for existing_ns in "${namespaces_to_collect[@]:-}"; do
                existing_ns=$(echo "$existing_ns" | xargs)
                if [[ "$existing_ns" == "$orch_ns" ]]; then
                    already_included=true
                    break
                fi
            done
            if [[ "$already_included" != "true" ]]; then
                namespaces_to_collect+=("$orch_ns")
                log_info "Added orchestrator namespace: $orch_ns"
            fi
        done < "$orch_ns_file"
    fi
fi

if [[ ${#namespaces_to_collect[@]} -eq 0 ]]; then
    log_warn "No RHDH deployments or orchestrator components found in cluster"
    echo "No namespaces detected" > "$np_dir/no-namespaces.txt"
    exit 0
fi

declare -a cleaned_namespaces=()
for ns in "${namespaces_to_collect[@]}"; do
    ns=$(echo "$ns" | xargs)
    [[ -z "$ns" ]] && continue
    already_present=false
    for existing in "${cleaned_namespaces[@]:-}"; do
        if [[ "$existing" == "$ns" ]]; then
            already_present=true
            break
        fi
    done
    if [[ "$already_present" != "true" ]]; then
        cleaned_namespaces+=("$ns")
    fi
done
namespaces_to_collect=("${cleaned_namespaces[@]:-}")

log_info "Found ${#namespaces_to_collect[@]} namespace(s) for NetworkPolicy collection: ${namespaces_to_collect[*]}"

{
    printf '%s\n' "${namespaces_to_collect[@]}"
} > "$np_dir/detected-namespaces.txt"

for ns in "${namespaces_to_collect[@]}"; do
    log_info "Collecting NetworkPolicies in namespace $ns"

    ns_dir="$np_dir/ns=$ns"
    ensure_directory "$ns_dir"

    # Inventory (names, ages) — Support's first glance
    safe_exec "$KUBECTL_CMD get networkpolicy -n '$ns'" \
        "$ns_dir/networkpolicies.txt" \
        "NetworkPolicy list in $ns"

    # Full specs — selectors, ports, CIDRs (AC1)
    safe_exec "$KUBECTL_CMD get networkpolicy -n '$ns' -o yaml" \
        "$ns_dir/networkpolicies.yaml" \
        "NetworkPolicy YAML in $ns"

    # Human-readable view — what Support actually reads
    safe_exec "$KUBECTL_CMD describe networkpolicy -n '$ns'" \
        "$ns_dir/networkpolicies.describe.txt" \
        "NetworkPolicy describe in $ns"

    # Labels on the policy objects (Helm vs Operator vs user-created)
    safe_exec "$KUBECTL_CMD get networkpolicy -n '$ns' --show-labels" \
        "$ns_dir/networkpolicies.labels.txt" \
        "NetworkPolicy labels in $ns"

     # AC2: labels that NetworkPolicy podSelector / same-namespace peers match
    safe_exec "$KUBECTL_CMD get namespace '$ns' -o yaml" \
      "$ns_dir/namespace.yaml" \
      "Namespace labels for $ns"

    safe_exec "$KUBECTL_CMD get pods -n '$ns' --show-labels -o wide" \
      "$ns_dir/pods-show-labels.txt" \
      "Pod labels in $ns"

    safe_exec "$KUBECTL_CMD get svc -n '$ns' -o yaml" \
      "$ns_dir/services.yaml" \
      "Services (ports) in $ns" 

    safe_exec "$KUBECTL_CMD get networkpolicy -n '$ns' -o json" \
      "$ns_dir/networkpolicies.json" \
      "NetworkPolicy JSON in $ns"
done

peer_dir="$np_dir/peer-namespaces"
ensure_directory "$peer_dir"

# Namespaces commonly referenced by RHDH NetworkPolicy namespaceSelectors.
# Missing namespaces still get an error file from safe_exec; that is useful as a log too.
peer_namespaces=(
    openshift-ingress
    openshift-monitoring
    openshift-user-workload-monitoring
    knative-serving
    knative-eventing
    openshift-serverless-logic
    monitoring
    gmp-system
    gke-gmp-system
)

for peer in "${peer_namespaces[@]}"; do
    safe_exec "$KUBECTL_CMD get namespace '$peer' -o yaml" \
      "$peer_dir/${peer}.yaml" \
      "Peer namespace $peer"
done

log_info "Writing NetworkPolicy diagnostic summary..."

summary_file="$np_dir/summary.txt"
{
    echo "NetworkPolicy diagnostic summary"
    echo "================================"
    echo "Collected at: $(date -u +"%Y-%m-%dT%H:%M:%SZ")"
    echo ""
    echo "This dump is for connectivity failures caused by NetworkPolicies"
    echo "(default-deny, wrong pod/namespace labels, missing user additive policies)."
    echo ""
    echo "RHDH namespaces collected:"
    for ns in "${namespaces_to_collect[@]}"; do
        echo "  - $ns"
    done
    echo ""

    for ns in "${namespaces_to_collect[@]}"; do
        echo "Namespace: $ns"
        echo "----------"
        json="$np_dir/ns=$ns/networkpolicies.json"
        if [[ -f "$json" ]] && jq -e '.items' "$json" >/dev/null 2>&1; then
            echo "  NetworkPolicy count: $(jq '.items | length' "$json")"
            jq -r '
              .items[] |
              "  - \(.metadata.name)\n" +
              "      policyTypes: \(.spec.policyTypes | tostring)\n" +
              "      podSelector: \(.spec.podSelector | tostring)"
            ' "$json"
            echo "  namespaceSelectors (peers these policies allow from/to):"
            jq -r '
              .items[] |
              .metadata.name as $name |
              [
                (.spec.ingress[]? | .from[]? | .namespaceSelector.matchLabels // empty),
                (.spec.egress[]?  | .to[]?   | .namespaceSelector.matchLabels // empty)
              ] |
              .[] |
              "      \($name): \(tostring)"
            ' "$json" 2>/dev/null || echo "      (none found)"
        else
            echo "  NetworkPolicy JSON not usable (cluster unreachable or kubectl error)."
            echo "  See ns=$ns/networkpolicies.yaml for raw output."
        fi
        echo "  Pod labels:       ns=$ns/pods-show-labels.txt"
        echo "  Namespace labels: ns=$ns/namespace.yaml"
        echo "  Services/ports:   ns=$ns/services.yaml"
        echo ""
    done

    echo "Peer namespaces (for namespaceSelector matching):"
    echo "  Directory: peer-namespaces/"
    echo "  Compare labels in those YAML files to namespaceSelector in the policies."
    echo ""
    echo "How to troubleshoot with this dump:"
    echo "  1. Find default-deny and allow policies in ns=*/networkpolicies.yaml"
    echo "  2. Match spec.podSelector to lines in pods-show-labels.txt"
    echo "     (Helm: app.kubernetes.io/name=developer-hub / postgresql;"
    echo "      Operator: rhdh.redhat.com/app=backstage-<cr> / backstage-psql-<cr>)"
    echo "  3. For UI (7007) or metrics (9464), match namespaceSelector to"
    echo "     peer-namespaces/*.yaml (ingress / openshift-monitoring labels)"
    echo "  4. If a plugin uses a port other than 443, look for a user-created"
    echo "     additive NetworkPolicy; base policies only allow DNS + HTTPS 443"
    echo "     (+ Redis 6379, Postgres 5432, etc.)"
    echo "  5. Empty policy list + pods still isolated may mean a cluster-level"
    echo "     AdminNetworkPolicy, or CNI not enforcing NetworkPolicies"
} > "$summary_file"

log_info "Summary written to $summary_file"

log_success "NetworkPolicy collection completed for ${#namespaces_to_collect[@]} namespace(s)."