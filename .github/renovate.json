{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "baseBranchPatterns": ["main", "/^release-.*/"],
  "packageRules": [
    {
      "description": "Disable all updates on release branches by default",
      "matchBaseBranches": ["/^release-.*/"],
      "enabled": false
    },
    {
      "description": "Re-enable only patch updates on release branches",
      "matchBaseBranches": ["/^release-.*/"],
      "matchUpdateTypes": ["patch"],
      "enabled": true
    },
    {
      "description": "Re-enable digest updates for container images on release branches",
      "matchBaseBranches": ["/^release-.*/"],
      "matchManagers": ["dockerfile"],
      "matchUpdateTypes": ["digest"],
      "enabled": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.*\\.ya?ml$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=npm\\n\\s*npm install\\s+--no-save\\s+(?<depName>[^@\\s]+)@(?<currentValue>[\\d.]+)"
      ],
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.*\\.ya?ml$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=github-releases\\s+depName=(?<depName>\\S+)\\n\\s*python3 -m pip install.*?/refs/tags/(?<currentValue>v[\\d.]+)\\.zip"
      ],
      "datasourceTemplate": "github-releases"
    }
  ]
}
